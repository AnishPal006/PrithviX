# Copy this file to .env and fill in real values as they become available.
# The app runs fine with none of these set — external calls fall back to
# seeded/mock data automatically.

# --- Database ---
# Default: SQLite file (zero setup). Switch to Postgres when ready, e.g.
# DATABASE_URL=postgresql://user:password@localhost:5432/prithvix
DATABASE_URL=sqlite:///./prithvix.db

# --- Auth ---
SECRET_KEY=change-this-to-a-random-string-before-real-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- External data APIs (free / keyless — used automatically if reachable) ---
# NASA POWER and Open-Meteo need no API key.

# --- External data APIs (need keys — leave blank to use mock data) ---
OPENWEATHERMAP_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- Alerts (leave blank to log alerts instead of sending) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=alerts@prithvix.local
